# API base URL in the browser. Leave empty to use Next rewrites (same origin).
NEXT_PUBLIC_API_URL=
# Server-side rewrites: local dev defaults to http://127.0.0.1:4000 (`pnpm dev:api`).
# On Vercel (web project): set to your API deployment origin, e.g. https://your-api.vercel.app
# API_PROXY_TARGET=https://your-api.vercel.app
