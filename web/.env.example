# API base URL in the browser. Leave empty to use Next rewrites (same origin).
NEXT_PUBLIC_API_URL=
# Local dev: proxy /auth and /api to `pnpm dev:api` (default http://127.0.0.1:4000).
# Use API_PROXY_TARGET=same-origin to hit the in-project Hono route (/api/hono) instead.
# On Vercel: leave unset so rewrites use /api/hono (no external API).
# API_PROXY_TARGET=http://127.0.0.1:4000
