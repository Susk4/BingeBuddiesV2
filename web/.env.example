# Browser API base. Leave empty for same-origin (/api, /auth via Next rewrites).
NEXT_PUBLIC_API_URL=

# Local dev: Next proxies to http://127.0.0.1:4000 when unset in development.
# Vercel (production): set to your Hono API origin (Railway, Fly, Render, etc.)
# API_PROXY_TARGET=https://api.example.com
