{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm run build:web",
    "watchPatterns": [
      "web/**",
      "packages/shared/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      "railpack.web.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @binge-buddies/web start",
    "variables": {
      "HOSTNAME": "0.0.0.0"
    }
  }
}
