{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "backend/**",
      "packages/shared/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      "railpack.json"
    ]
  },
  "deploy": {
    "startCommand": "node backend/dist/index.js"
  }
}
