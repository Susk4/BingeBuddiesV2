{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "pnpm": "9"
  },
  "steps": {
    "build": {
      "commands": ["...", "pnpm run build:web"]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @binge-buddies/web start",
    "variables": {
      "HOSTNAME": "0.0.0.0"
    }
  }
}
