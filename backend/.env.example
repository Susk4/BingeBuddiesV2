PORT=4000
# Local SQLite file (libsql) or remote: libsql://… / https://…
DATABASE_URL=./data/binge.sqlite
LIBSQL_AUTH_TOKEN=your-libsql-auth-token
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000

# Session cookie (httpOnly, set by API on OAuth callback)
SESSION_COOKIE_NAME=bb_session

TMDB_TOKEN=your-tmdb-api-key
TMDB_KEY=your-tmdb-api-key
# Watch region for provider filters on discover (ISO 3166-1)
TMDB_WATCH_REGION=US
